#!/bin/sh
set -e

# AppRun launcher for Flow Control Client AppImage
HERE="$(dirname "$(readlink -f "$0")")"

export APPDIR="$HERE"
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/bin:$LD_LIBRARY_PATH"
export QT_PLUGIN_PATH="$HERE/usr/plugins:$QT_PLUGIN_PATH"
export QML2_IMPORT_PATH="$HERE/usr/qml:$HERE/usr/bin/contents/qml:$QML2_IMPORT_PATH"

# Run main binary
exec "$HERE/usr/bin/FlowControl" "$@"
